{
  "name": "RDT4quantv1",
  "data_days": 180,
  "instruments": ["BTC-USDT", "BTC-USDT-SWAP", "ETH-USDT"],
  "target": "BTC-USDT",
  "bar": "1m",
  "request_rate_per_second": 3,
  "download_workers": 6,
  "sequence_length": 480,
  "horizons_minutes": [15, 60, 240],
  "quantiles": [0.1, 0.5, 0.9],
  "validation_days": 21,
  "test_days": 21,
  "train_stride": 15,
  "evaluation_stride": 15,
  "seeds": [7, 23, 47],
  "depths": [1, 2, 4, 8],
  "epochs": 16,
  "patience": 4,
  "batch_size": 16,
  "accumulation_steps": 2,
  "learning_rate": 0.0001,
  "weight_decay": 0.01,
  "gradient_clip": 1.0,
  "roundtrip_cost_bps": [10, 20, 30],
  "model": {
    "d_model": 256,
    "n_heads": 4,
    "head_dim": 64,
    "rope_head_dim": 32,
    "nope_head_dim": 32,
    "kv_lora_rank": 64,
    "ffn_hidden": 768,
    "n_prelude": 0,
    "n_coda": 0,
    "core_type": "two_stage",
    "stage1_mamba_layers": 3,
    "stage2_attn_layers": 1,
    "recurrent_steps": 8,
    "recurrent_drift_mode": "mhc",
    "mhc_n_streams": 4,
    "mhc_sinkhorn_iters": 20,
    "mamba_d_state": 64,
    "mamba_headdim": 64,
    "mamba_expand": 2,
    "mamba_chunk_size": 64,
    "use_official_mamba": true,
    "use_morphological_rope": false,
    "bidirectional": false,
    "max_seq_len": 480,
    "grad_ckpt_blocks": false,
    "grad_ckpt_recurrent": true
  }
}
